{
  "projectId": "MartinoPolo/obsidian-tasks-dashboard-plugin",
  "repository": {
    "provider": "github",
    "remote": "origin"
  },
  "issues": {
    "provider": "github"
  },
  "packageManager": "pnpm",
  "fast_checks": [
    { "command": "pnpm run format", "cwd": "." },
    { "command": "pnpm run typecheck", "cwd": "." },
    { "command": "pnpm run test", "cwd": "." }
  ],
  "full_checks": [
    { "command": "pnpm run lint", "cwd": "." },
    { "command": "node esbuild.config.mjs production", "cwd": "." }
  ]
}
